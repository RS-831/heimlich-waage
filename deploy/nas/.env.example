# Kopieren nach .env (neben docker-compose.yml) und anpassen. Die .env nicht veröffentlichen.

# Adresse, unter der die Waage erreichbar sein soll
WAAGE_HOST=waage.example.org

# Traefik-Middleware für die Anmeldung (Forward-Auth zu Authelia)
TRAEFIK_AUTH_MIDDLEWARE=authelia@docker

# Abmelde-Adresse von Authelia (leer = kein Abmelde-Link)
AUTH_LOGOUT_URL=https://auth.example.org/logout

# Gruppen aus Authelia
AUTH_ADMIN_GROUP=admins
AUTH_REQUIRED_GROUP=users

# Login-Name, der beim ersten Anmelden die bisherigen Daten des lokalen Betriebs übernimmt.
# Leer lassen, wenn es keine alten Daten gibt.
AUTH_ADOPT_DEFAULT_USER=

# Optional: nur Anfragen von diesen Adressen annehmen (kommagetrennt, IPs oder Netze)
AUTH_TRUSTED_PROXIES=

# Optional: anderer Port auf 127.0.0.1 oder ein bestimmtes Image-Tag
# WAAGE_PORT=8000
# WAAGE_IMAGE=ghcr.io/rs-831/heimlich-waage:latest
