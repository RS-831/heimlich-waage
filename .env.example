# Kopieren nach .env und anpassen (.env wird nicht eingecheckt)

# Ordner mit der Datendatei auf dem Host / NAS. Besser absolut angeben (z. B. /home/<benutzer>/gewicht-daten):
# "~" zeigt bei sudo auf /root.
DATA_PATH=~/gewicht-daten
# Name der Datendatei in diesem Ordner
DB_FILE=gewicht.db
PORT=8000
# spaeter auf dem NAS: local
AUTH_MODE=none
# Besitzer der Dateien im Datenordner (id -u / id -g)
UID=1000
GID=1000
